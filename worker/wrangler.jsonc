{
  "name": "pieceoff-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomDO" },
      { "name": "REGISTRY", "class_name": "RegistryDO" },
      { "name": "LOBBY", "class_name": "LobbyDO" }
    ]
  },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "pieceoff-media" }],
  "ratelimits": [
    { "name": "CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOOKUP_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } },
    { "name": "LINK_LIMITER", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOBBY_LIMITER", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],
  // Non-secret settings. Secrets (TURNSTILE_SECRET, ADMIN_TOKEN) are set in
  // the Cloudflare dashboard or with `wrangler secret put`; see docs/DEPLOYMENT.md.
  "vars": {
    // Hosted uploads stay off until abuse contact, takedown and a hash blocklist exist.
    "MEDIA_UPLOADS_ENABLED": "0",
    "SITE_ORIGIN": "https://pieceoff.app",
    "TURNSTILE_HOSTNAME": "pieceoff.app",
    "LINK_URL": "https://pieceoff.app/link",
    "SHARE_URL": "https://pieceoff.app/join",
    "MEDIA_GLOBAL_QUOTA_BYTES": "8589934592",
    "DEVICE_ROOMS_PER_DAY": "30",
    // Hard daily ceilings for the whole service (UTC day), so many devices and
    // addresses together cannot run up the account's bill. Past them, room
    // creation and link requests answer 503 until midnight UTC; joining
    // existing rooms and the lobby keep working. Today's counts:
    // GET /api/admin/usage (ADMIN_TOKEN).
    "GLOBAL_ROOMS_PER_DAY": "2000",
    "GLOBAL_LINKS_PER_DAY": "500",
    "DEVICE_MEDIA_BYTES_PER_DAY": "2147483648"
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDO"] },
    { "tag": "v2", "new_sqlite_classes": ["RegistryDO", "LobbyDO"] }
  ],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true }]
}
