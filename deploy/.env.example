# Copy to .env and edit. Only PIECEOFF_DOMAIN is required.

# The public name of this server (its DNS record must point at this machine).
PIECEOFF_DOMAIN=rooms.example.com

# Optional limits (these are the defaults).
# PIECEOFF_MEDIA_QUOTA_BYTES=53687091200
# PIECEOFF_MAX_MEDIA_BYTES=17179869184
# PIECEOFF_ROOM_TTL_DAYS=90
# PIECEOFF_MAX_ROOMS=500
# PIECEOFF_MAX_CONNECTIONS=400
