# nginx in front of the PieceOff room server (TLS certificates not shown:
# use certbot or your usual setup). Three things matter for this server:
# WebSocket upgrades, no request buffering or size cap for multi-GB uploads, and
# timeouts longer than the server's 20-second heartbeat.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl http2;
    server_name rooms.example.com;
    # ssl_certificate     /etc/letsencrypt/live/rooms.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/rooms.example.com/privkey.pem;

    # Media uploads go through this proxy and are streamed to disk.
    client_max_body_size 0;   # the server enforces PIECEOFF_MAX_MEDIA_BYTES
    proxy_request_buffering off;
    proxy_buffering off;

    location / {
        proxy_pass http://127.0.0.1:28878;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # Overwrite, never append: the server trusts this header when
        # PIECEOFF_TRUST_PROXY=1, so a client must not be able to supply it.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}
