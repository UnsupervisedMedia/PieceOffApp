# /etc/pieceoff/server.env: settings for the systemd service. Every line is
# optional; the values shown are the defaults except where noted.

# Listen on loopback only when a reverse proxy on this machine fronts the
# server (recommended); the default 0.0.0.0:28878 accepts connections from
# anywhere.
PIECEOFF_BIND=127.0.0.1:28878

# Believe X-Forwarded-For. Set to 1 only behind a proxy that overwrites it
# (see deploy/Caddyfile and deploy/nginx.conf.example).
PIECEOFF_TRUST_PROXY=1

# PIECEOFF_MEDIA_QUOTA_BYTES=53687091200
# PIECEOFF_MAX_MEDIA_BYTES=17179869184
# PIECEOFF_ROOM_TTL_DAYS=90
# PIECEOFF_MAX_ROOMS=500
# PIECEOFF_MAX_CONNECTIONS=400
# PIECEOFF_MAX_MESSAGE_BYTES=1048576
# PIECEOFF_CONNECTIONS_PER_MINUTE=60
# PIECEOFF_FAILED_JOINS_PER_HOUR=20
# PIECEOFF_ALLOWED_ORIGINS=https://play.example.com
